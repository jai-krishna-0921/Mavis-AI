# Automatic Let's Encrypt for {$DOMAIN} (e.g. 13-233-10-5.sslip.io, no domain purchase needed).
# The api owns /api, /oauth, /webhooks, /telegram/webhook, /connect/callback and /healthz.
# Everything else is the static web app in /srv/web (built into the caddy image, see
# deploy/caddy/Dockerfile) with an SPA fallback. If /srv/web is missing or empty, those paths
# return 404 as before.
{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /oauth/* /webhooks/* /telegram/webhook /connect/callback /healthz
	handle @api {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv/web

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			Strict-Transport-Security "max-age=31536000"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# Hashed build output never changes under the same name; everything else revalidates.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
