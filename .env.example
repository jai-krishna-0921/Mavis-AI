# --- LLM (Ollama Cloud free tier) ---
OLLAMA_API_KEY=
MODEL_FAST=gpt-oss:20b
MODEL_SMART=gpt-oss:120b
# Fallback chains (JSON lists), tried in order when the primary model times out / is unreachable / 5xx / 429.
# Each attempt makes a single try (no same-model retries), so a dead model costs one timeout, not three.
MODEL_FAST_FALLBACKS=["gemma4:31b", "gpt-oss:120b"]
MODEL_SMART_FALLBACKS=["gpt-oss:20b"]
# Per-attempt timeouts in seconds (FAST is short so fallback kicks in quickly).
# Max simultaneous LLM calls in this process (free tier returns 429 'too many concurrent requests' above ~1-2).
# Interactive replies jump ahead of background (memory/LEARN) calls, and background calls yield (fail fast and
# are dropped) while a reply is waiting or ran in the last 20s; 429s are retried with backoff on the same model.
LLM_MAX_CONCURRENCY=1
LLM_TIMEOUT_FAST_S=30
LLM_TIMEOUT_SMART_S=60
LLM_TIMEOUT_COOLDOWN_S=45
# reasoning_effort for FAST-tier gpt-oss models only (low/medium/high); empty = not sent
LLM_REASONING_EFFORT_FAST=low
# Optional secondary provider (e.g. Groq); empty = off
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL_FAST=
LLM_SECONDARY_MODEL_SMART=
LLM_SECONDARY_MAX_CONCURRENCY=2
# Emoji reaction on incoming messages; empty = off
PRESENCE_REACTION=

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
# Required for the webhook route: with an empty secret every webhook request gets 403.
TELEGRAM_WEBHOOK_SECRET=
# JSON list of chat ids allowed to talk to the bot (single-user mode). Empty = everyone ONLY when ENV=dev; otherwise all chats are denied (see the `telegram.chat_not_allowed` log line for your chat id).
ALLOWED_TELEGRAM_CHAT_IDS=[]

# --- bus / worker ---
# Redeliver an unacked bus message after this idle time; keep above the longest handler runtime.
BUS_CLAIM_IDLE_MS=900000
# Consumer loops per stream per worker process.
WORKER_CONCURRENCY=4

# --- storage (empty = local embedded fallbacks; REDIS_URL is REQUIRED for `mavis api` / `mavis worker`) ---
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- integrations / tools ---
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
TAVILY_API_KEY=

# --- sandbox (Phase 6): docker (gVisor) via sandboxd sidecar | agentcore | local ---
SANDBOX_BACKEND=auto
SANDBOXD_SOCKET=
AWS_PROFILE=
AGENTCORE_REGION=ap-south-1

# --- observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- environment: dev | prod | test ---
ENV=dev

# --- behaviour ---
DEFAULT_TIMEZONE=Asia/Kolkata
PUBLIC_BASE_URL=http://localhost:8000
PING_DAILY_BUDGET=6
QUIET_START=23
QUIET_END=7
DEMO_TIME_SCALE=1.0
ADMIN_USER=admin
ADMIN_PASSWORD=
