# Production .env template for the single-box deploy. NO secrets live here.
# deploy/aws/deploy.sh builds the real file from the demo .env keys plus generated secrets.
ENV=prod
PUBLIC_BASE_URL=https://REPLACE-WITH-EIP-DASHES.sslip.io
DOMAIN=REPLACE-WITH-EIP-DASHES.sslip.io
DEFAULT_TIMEZONE=Asia/Kolkata

# copied from the local .env by the deploy script
OLLAMA_API_KEY=
TAVILY_API_KEY=
COMPOSIO_API_KEY=
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_CHAT_IDS=[123456789]

# empty keeps Composio on polling (no inbound Composio webhook needed)
COMPOSIO_WEBHOOK_SECRET=

# generated by the deploy script (kept stable across redeploys)
TELEGRAM_WEBHOOK_SECRET=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

TELEGRAM_MODE=webhook
LLM_MAX_CONCURRENCY=1

# attention layer (optional; the defaults are shown). First-deploy backfill size, lower if the LLM free tier struggles:
# ATTENTION_BACKFILL_MAX=120
