{
  "display_information": {
    "name": "Mavis AI",
    "description": "Your personal AI assistant for email, calendar, files and Slack. Ask in a DM, it handles the rest.",
    "long_description": "Mavis is a personal assistant that knows your work. Message it here in Slack or on Telegram and it picks up where you left off.\n\n*What it does*\n• Reads your Gmail, Calendar and Drive, and the Slack DMs and channels you are in, so it knows your people, projects and deadlines.\n• Tells you what is on your plate, drafts and sends replies, books meetings and keeps track of what you promised.\n• Researches and writes: designed slide decks, analysis reports and spreadsheets, saved to your Drive.\n• Speaks up first when something needs you, and sends a morning check-in.\n\n*Your data stays yours*\nMavis reads only what you can already read. Anything that goes out to another person, or spends money, waits for your tap. Disconnect anytime with /disconnect.\n",
    "background_color": "#E8572A"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Mavis",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/channel",
        "url": "https://mavis-0de9f18d.sslip.io/webhooks/slack/interactive",
        "description": "Choose where Mavis sends its own messages",
        "usage_hint": "[telegram|slack|both]",
        "should_escape": false
      },
      {
        "command": "/connect",
        "url": "https://mavis-0de9f18d.sslip.io/webhooks/slack/interactive",
        "description": "Connect an account",
        "usage_hint": "[google|slack]",
        "should_escape": false
      },
      {
        "command": "/connections",
        "url": "https://mavis-0de9f18d.sslip.io/webhooks/slack/interactive",
        "description": "Show connected accounts",
        "should_escape": false
      },
      {
        "command": "/disconnect",
        "url": "https://mavis-0de9f18d.sslip.io/webhooks/slack/interactive",
        "description": "Disconnect an account",
        "usage_hint": "[google|slack]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://mavis-0de9f18d.sslip.io/oauth/slack/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:read",
        "im:write",
        "app_mentions:read",
        "reactions:write",
        "users:read",
        "files:write",
        "commands"
      ],
      "user": [
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:read",
        "groups:read",
        "im:read",
        "mpim:read",
        "users:read",
        "users:read.email",
        "chat:write",
        "search:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://mavis-0de9f18d.sslip.io/webhooks/slack",
      "bot_events": [
        "message.im",
        "app_mention"
      ],
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://mavis-0de9f18d.sslip.io/webhooks/slack/interactive"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}